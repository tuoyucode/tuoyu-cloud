<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.tuoyu</groupId>
        <artifactId>tuoyu-cloud</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>tuoyu-architecture</artifactId>

    <description>
        tuoyu-architecture 依赖规则检查：只有测试，读取各模块编译后的类，不发布
    </description>

    <properties>
        <archunit.version>1.4.1</archunit.version>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <!-- ArchUnit（Apache-2.0），只用于测试 -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
            -P business：业务模块放在本模块之前构建，规则检查读取得到它们编译后的类。
            依赖只用于决定构建顺序，测试读取的是各模块的 target/classes
        -->
        <profile>
            <id>business</id>
            <dependencies>
                <dependency>
                    <groupId>org.tuoyu</groupId>
                    <artifactId>tuoyu-mes</artifactId>
                    <version>${revision}</version>
                    <scope>test</scope>
                    <exclusions>
                        <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
                    </exclusions>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

</project>
