<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.tuoyu</groupId>
    <artifactId>tuoyu-common-bom</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <description>
        tuoyu-common-bom common依赖项
    </description>

    <properties>
        <revision>1.0.0-alpha.1</revision>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 核心模块 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-core</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 接口模块 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-doc</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 安全模块 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-security</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 权限认证服务 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-satoken</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 日志记录 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-log</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 业务模块的菜单登记 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-menu</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 通用service实现模块 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-service-impl</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- excel -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-excel</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 缓存服务 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-redis</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- web服务 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-web</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 数据库服务 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-mybatis</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 定时任务 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-job</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- RPC服务 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-dubbo</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 分布式事务 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-seata</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 自定义负载均衡 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-loadbalancer</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- oss服务 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-oss</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 邮件模块 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-mail</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 短信模块 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-sms</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- logstash日志推送模块 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-logstash</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- ES搜索引擎服务 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-elasticsearch</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- skywalking日志收集模块 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-skylog</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- prometheus监控 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-prometheus</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 通用翻译功能 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-translation</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 脱敏模块 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-sensitive</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 序列化模块 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-json</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 数据加解密模块 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-encrypt</artifactId>
                <version>${revision}</version>
            </dependency>


            <!-- 消息推送模块 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-push</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- liteflow模块 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-liteflow</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 授权认证 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-social</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 配置中心 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-nacos</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 消息总线模块 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-bus</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- AI模块 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-ai</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-mqtt</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- mcp模块 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-mcp</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 启动自检 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-selfcheck</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 数据库迁移 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-flyway</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 跨模块调用抽象：单体中本地调用，微服务中走 Dubbo -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-rpc</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 日志追踪与优雅停机 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-observability</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 多租户 -->
            <dependency>
                <groupId>org.tuoyu</groupId>
                <artifactId>tuoyu-common-tenant</artifactId>
                <version>${revision}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>
</project>
