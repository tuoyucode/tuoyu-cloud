<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.tuoyu</groupId>
        <artifactId>tuoyu-framework</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>tuoyu-common-dubbo</artifactId>

    <description>
        tuoyu-common-dubbo RPC服务
    </description>

    <dependencies>
        <dependency>
            <groupId>org.tuoyu</groupId>
            <artifactId>tuoyu-common-json</artifactId>
        </dependency>

        <!-- 跨模块调用抽象：本模块是它在微服务方式下的 Dubbo 实现（ADR 0005） -->
        <dependency>
            <groupId>org.tuoyu</groupId>
            <artifactId>tuoyu-common-rpc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-context</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.dubbo</groupId>
            <artifactId>dubbo-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.dubbo</groupId>
            <artifactId>dubbo-spring-boot-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.tuoyu</groupId>
            <artifactId>tuoyu-common-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- Sa-Token 整合 Dubbo -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-dubbo3</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.dubbo</groupId>
                    <artifactId>dubbo</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-commons</artifactId>
        </dependency>

        <!-- 测试：真实 Dubbo 调用中的链路透传 -->
        <dependency>
            <groupId>org.tuoyu</groupId>
            <artifactId>tuoyu-common-observability</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>
</project>
