<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.tuoyu</groupId>
        <artifactId>tuoyu-framework</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>tuoyu-common-observability</artifactId>

    <description>
        tuoyu-common-observability 日志追踪与优雅停机（见 docs/adr/0007-日志追踪与优雅停机.md）：
        W3C traceparent 链路 ID 写入日志、跨线程跨服务透传；停机时先下线再排空请求。
        除 Spring Boot 外的依赖都是可选的：监控中心等不带 tuoyu-common-core 的服务也能使用
    </description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- 上下文透传 SPI（ContextPropagator）：有 core 的服务才注册透传实现 -->
        <dependency>
            <groupId>org.tuoyu</groupId>
            <artifactId>tuoyu-common-core</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Servlet 入口过滤器 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-servlet</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 停机时排空 Web 容器中的请求 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-web-server</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 停机时先从注册中心下线（Spring Cloud 服务注册） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-commons</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试：单体方式下跨模块调用（本地调用代理）与 @Async 中的透传 -->
        <dependency>
            <groupId>org.tuoyu</groupId>
            <artifactId>tuoyu-common-rpc</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
