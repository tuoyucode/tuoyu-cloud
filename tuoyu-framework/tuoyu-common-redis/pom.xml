<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.tuoyu</groupId>
        <artifactId>tuoyu-framework</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>tuoyu-common-redis</artifactId>

    <description>
        tuoyu-common-redis 缓存服务
    </description>

    <dependencies>
        <!-- TuoYu Common Core-->
        <dependency>
            <groupId>org.tuoyu</groupId>
            <artifactId>tuoyu-common-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.tuoyu</groupId>
            <artifactId>tuoyu-common-json</artifactId>
        </dependency>

        <!--redisson-->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-cache</artifactId>
            <version>${redisson.version}</version>
        </dependency>

        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>lock4j-redisson-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-crypto</artifactId>
        </dependency>

        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-core</artifactId>
        </dependency>

        <!-- redis序列化替代方案 比json快无数的跨语言二进制序列化 -->
        <dependency>
            <groupId>org.apache.fory</groupId>
            <artifactId>fory-core</artifactId>
        </dependency>

        <!-- 可选：服务启动后把启动自检结果写入 Redis，供安全中心汇总各服务的结果 -->
        <dependency>
            <groupId>org.tuoyu</groupId>
            <artifactId>tuoyu-common-selfcheck</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试：使用真实的登录用户等类型验证 Redis 序列化白名单 -->
        <dependency>
            <groupId>org.tuoyu</groupId>
            <artifactId>tuoyu-api-system</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
