<!--            <artifactId>orai18n</artifactId>-->
<!--        </dependency>-->
        <!-- PostgreSQL 驱动（BSD-2-Clause）：1.0 支持 MySQL 与 PostgreSQL，按 TUOYU_DB_TYPE 选择 -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
<!--        &lt;!&ndash; SqlServer &ndash;&gt;-->
