<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.tuoyu</groupId>
        <artifactId>tuoyu-modules</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>tuoyu-gen</artifactId>

    <description>
        tuoyu-gen代码生成
    </description>

    <dependencies>

        <dependency>
            <groupId>org.tuoyu</groupId>
            <artifactId>tuoyu-common-nacos</artifactId>
        </dependency>

        <!-- 启动自检 -->
        <dependency>
            <groupId>org.tuoyu</groupId>
            <artifactId>tuoyu-common-selfcheck</artifactId>
        </dependency>

        <!-- FreeMarker代码生成模板 -->
        <dependency>
            <groupId>org.freemarker</groupId>
            <artifactId>freemarker</artifactId>
        </dependency>

        <!-- TuoYu Common Log -->
        <dependency>
            <groupId>org.tuoyu</groupId>
            <artifactId>tuoyu-common-log</artifactId>
        </dependency>

        <dependency>
            <groupId>org.tuoyu</groupId>
            <artifactId>tuoyu-common-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.tuoyu</groupId>
            <artifactId>tuoyu-common-doc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.tuoyu</groupId>
            <artifactId>tuoyu-common-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.tuoyu</groupId>
            <artifactId>tuoyu-common-mybatis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.tuoyu</groupId>
            <artifactId>tuoyu-common-dubbo</artifactId>
        </dependency>


        <dependency>
            <groupId>org.tuoyu</groupId>
            <artifactId>tuoyu-common-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.anyline</groupId>
            <artifactId>anyline-environment-spring-data-jdbc</artifactId>
            <version>${anyline.version}</version>
        </dependency>

        <dependency>
            <groupId>org.anyline</groupId>
            <artifactId>anyline-data-jdbc-mysql</artifactId>
            <version>${anyline.version}</version>
        </dependency>

        <!-- anyline支持100+种类型数据库 添加对应的jdbc依赖与anyline对应数据库依赖包即可 -->
<!--        <dependency>-->
<!--            <groupId>org.anyline</groupId>-->
<!--            <artifactId>anyline-data-jdbc-oracle</artifactId>-->
<!--            <version>${anyline.version}</version>-->
<!--        </dependency>-->

        <!-- 代码生成读取 PostgreSQL 表结构（anyline，Apache-2.0） -->
        <dependency>
            <groupId>org.anyline</groupId>
            <artifactId>anyline-data-jdbc-postgresql</artifactId>
            <version>${anyline.version}</version>
        </dependency>

<!--        <dependency>-->
<!--            <groupId>org.anyline</groupId>-->
<!--            <artifactId>anyline-data-jdbc-mssql</artifactId>-->
<!--            <version>${anyline.version}</version>-->
<!--        </dependency>-->

    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <!-- 可执行 jar 带 exec 后缀（target/<模块>-exec.jar），普通 jar 留给单体启动器 tuoyu-boot-all 依赖 -->
                    <classifier>exec</classifier>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
