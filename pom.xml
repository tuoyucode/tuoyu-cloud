<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.tuoyu</groupId>
    <artifactId>tuoyu-cloud</artifactId>
    <version>${revision}</version>

    <name>TuoYu-Cloud</name>
    <url>https://gitee.com/tuoyucode/tuoyu-cloud</url>
    <description>TuoYu-Cloud 通用微服务框架</description>

    <properties>
        <!-- 项目基础配置 -->
        <revision>1.0.0-SNAPSHOT</revision>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>21</java.version>

        <!-- Spring 生态依赖版本（4.1.2 修复 Tomcat、Jackson、Freemarker 的高危漏洞） -->
        <spring-boot.version>4.1.2</spring-boot.version>
        <spring-cloud.version>2025.1.2</spring-cloud.version>
        <spring-boot-admin.version>4.1.1</spring-boot-admin.version>
        <spring-ai.version>2.0.1</spring-ai.version>
        <springdoc.version>3.1.1</springdoc.version>
        <swagger.core.version>2.2.55</swagger.core.version>

        <!-- 数据访问与持久化相关依赖版本 -->
        <mybatis.version>3.5.19</mybatis.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <mybatis-plus-join.version>1.5.9</mybatis-plus-join.version>
        <dynamic-ds.version>4.5.0</dynamic-ds.version>
        <anyline.version>8.7.3-20260306</anyline.version>
        <easy-es.version>3.0.2</easy-es.version>
        <elasticsearch-client.version>7.17.28</elasticsearch-client.version>

        <!-- 安全认证与加密相关依赖版本 -->
        <satoken.version>1.46.0</satoken.version>
        <justauth.version>3.0.1</justauth.version>
        <bouncycastle.version>1.86</bouncycastle.version>
        <!-- 富文本白名单清洗（MIT 协议） -->
        <jsoup.version>1.23.2</jsoup.version>
        <!--
            传递依赖的安全版本（CI 漏洞扫描）：只统一版本，不新增依赖。
            guava 由 SnailJob 客户端、Seata 等带入；commons-beanutils 由 LiteFlow 带入；bcprov 由 Spring Cloud 带入（与上面的 bouncycastle 统一）
        -->
        <guava.version>33.7.2-jre</guava.version>
        <commons-beanutils.version>1.11.0</commons-beanutils.version>

        <!-- 缓存、锁与任务调度相关依赖版本 -->
        <redisson.version>4.7.0</redisson.version>
        <lock4j.version>2.2.7</lock4j.version>
        <snailjob.version>2.0.2</snailjob.version>
        <snailai.version>1.1.1</snailai.version>

        <!-- 通用工具、编译增强与代码生成相关依赖版本 -->
        <hutool.version>5.8.47</hutool.version>
        <lombok.version>1.18.48</lombok.version>
        <mapstruct-plus.version>1.5.3</mapstruct-plus.version>
        <mapstruct-plus.lombok.version>0.2.0</mapstruct-plus.lombok.version>
        <therapi-javadoc.version>0.15.0</therapi-javadoc.version>
        <fesod.version>2.0.2-incubating</fesod.version>
        <fory.version>1.7.4</fory.version>

        <!-- 三方集成与业务扩展相关依赖版本 -->
        <!-- 离线IP地址定位库 -->
        <ip2region.version>3.3.7</ip2region.version>
        <!-- 日志采集 -->
        <logstash.version>9.0</logstash.version>
        <!-- 链路追踪 -->
        <skywalking-toolkit.version>9.6.0</skywalking-toolkit.version>
        <!-- 修复 alibaba 自带的 fastjson 相关漏洞(框架本身并未使用) -->
        <fastjson.version>1.2.84</fastjson.version>
        <fastjson2.version>2.0.64</fastjson2.version>
        <!-- OSS 配置 -->
        <aws.sdk.version>2.55.4</aws.sdk.version>
        <!-- SMS 配置 -->
        <sms4j.version>3.3.5</sms4j.version>
        <!-- 面向运行时的D-ORM依赖 -->
        <anyline.version>8.7.3-20260306</anyline.version>
        <!-- 工作流配置 -->
        <warm-flow.version>1.8.9</warm-flow.version>
        <liteflow.version>2.16.2.1</liteflow.version>
        <!-- mqtt客户端 -->
        <mica-mqtt.version>2.6.12</mica-mqtt.version>
        <!-- mq配置 -->
        <rocketmq.version>2.3.6</rocketmq.version>

        <!-- Maven 构建插件版本 -->
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
        <!-- 用于取得 mockito-core 的 jar 路径（dependency:properties），把 Mockito 作为测试 JVM 的代理加载 -->
        <maven-dependency-plugin.version>3.9.0</maven-dependency-plugin.version>
        <flatten-maven-plugin.version>1.8.0</flatten-maven-plugin.version>
        <!-- 覆盖率：JaCoCo 0.8.14，EPL-2.0，仅构建期使用，支持 JDK 25 的类文件 -->
        <jacoco-maven-plugin.version>0.8.14</jacoco-maven-plugin.version>
        <!--
            行覆盖率门槛（0 ~ 1）。默认 0，即不检查；核心模块在自己的 pom 中设为 0.50。
            JaCoCo 在 verify 阶段检查，未达到门槛时构建失败。
        -->
        <tuoyu.coverage.line-minimum>0</tuoyu.coverage.line-minimum>
        <!--
            代码检查：spotless（格式，Apache-2.0）与 PMD（缺陷与安全规则，maven-pmd-plugin 为 Apache-2.0，
            PMD 为 BSD 风格协议）。不使用 checkstyle（LGPL，见 CONTRIBUTING.md 基本规则第 7 条）
        -->
        <spotless-maven-plugin.version>2.44.4</spotless-maven-plugin.version>
        <maven-pmd-plugin.version>3.26.0</maven-pmd-plugin.version>
        <!--
            PMD 7.7.0 自带的 ASM 9.7 读不了 Java 25 的类文件（major version 69），在 JDK 25 上解析 JDK 自身的类时失败；
            ASM 9.8 起支持 Java 25（BSD-3-Clause，只在构建期使用）。升级 PMD 本身后可删除
        -->
        <pmd-asm.version>9.9.1</pmd-asm.version>
        <!-- 由 jacoco:prepare-agent 写入 JaCoCo 代理参数；默认为空，保证没有执行 prepare-agent 时 surefire 也能启动 -->
        <argLine></argLine>
        <!-- 测试不允许跳过（见 CONTRIBUTING.md 基本规则，CI 会检查） -->
        <maven.test.skip>false</maven.test.skip>
    </properties>

    <profiles>
        <!--
            运行环境不在构建时决定：同一份构建产物通过环境变量 TUOYU_PROFILES_ACTIVE 选择环境（默认 dev）。
            可选扩展模块默认不参与构建，需要时使用：mvn clean verify -P extensions
        -->
        <profile>
            <id>extensions</id>
            <modules>
                <module>tuoyu-extensions</module>
            </modules>
        </profile>
        <!--
            端到端测试：访问一个已经运行的系统（微服务经网关，或单体），默认不参与构建。
            mvn -P e2e -pl tuoyu-e2e verify -Dtuoyu.e2e.base-url=http://localhost:8081（管理员口令用环境变量 TUOYU_E2E_PASSWORD 传入）
        -->
        <!--
            修正格式：mvn -P format compile。只在继承本 pom 的模块执行
            （直接执行 mvn spotless:apply 会在不继承本 pom 的 BOM 模块上报错）
        -->
        <profile>
            <id>format</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.diffplug.spotless</groupId>
                        <artifactId>spotless-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>spotless-apply</id>
                                <phase>process-sources</phase>
                                <goals>
                                    <goal>apply</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>e2e</id>
            <modules>
                <module>tuoyu-e2e</module>
            </modules>
        </profile>
    </profiles>

